[gd_scene load_steps=4 format=3 uid="uid://dfxxrh3fefwru"]

[sub_resource type="GDScript" id="GDScript_banner"]
script/source = "extends Node2D

signal option_changed(option: String)

@export var options: Array[String] = [\"\", \"★ host ★ host ★ host ★ host \", \"★ join ★ join ★ join ★ join \", \"★ train ★ train ★ train ★ train \"]
@export var transition_duration: float = 0.3

var current_index: int = 0
var target_y: float = 0.0
var current_tween: Tween = null

@onready var options_container: Node2D = $OptionsContainer

func _ready() -> void:
	_setup_options()
	set_option(0)

func _setup_options() -> void:
	for i in range(options_container.get_child_count()):
		var row = options_container.get_child(i)
		for label in row.get_children():
			label.text = options[i % options.size()]

func set_option(index: int) -> void:
	if index < 0 or index >= options.size():
		return
	current_index = index
	target_y = -index * 250.0
	_animate_to_target()
	option_changed.emit(options[index])

func set_option_by_name(option_name: String) -> void:
	for i in range(options.size()):
		if options[i].to_lower().contains(option_name.to_lower()):
			set_option(i)
			return

func next_option() -> void:
	set_option((current_index + 1) % options.size())

func prev_option() -> void:
	set_option((current_index - 1 + options.size()) % options.size())

func _animate_to_target() -> void:
	if current_tween and current_tween.is_valid():
		current_tween.kill()
	current_tween = create_tween()
	current_tween.tween_property(options_container, \"position:y\", target_y, transition_duration)
	current_tween.set_ease(Tween.EASE_OUT)
	current_tween.set_trans(Tween.TRANS_CUBIC)
"

[sub_resource type="GDScript" id="GDScript_scroll"]
script/source = "extends Control

@export var scroll_speed: float = 150.0
@export var segment_width: float = 1400.0

func _process(delta: float) -> void:
	var count = get_child_count()
	for label in get_children():
		label.position.x -= scroll_speed * delta
		if label.position.x <= -segment_width:
			label.position.x += segment_width * count
"

