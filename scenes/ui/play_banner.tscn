[gd_scene load_steps=3 format=3 uid="uid://bxsesw7l3jrv0"]

[sub_resource type="GDScript" id="GDScript_scroll"]
script/source = "extends Control

@export var speed: float = 150.0
@export var segment_width: float = 600.0

func _process(delta: float) -> void:
	var count = get_child_count()
	for label in get_children():
		label.position.x -= speed * delta
		if label.position.x <= -segment_width:
			label.position.x += segment_width * count
"

