script = ExtResource("1_script")
id = "Gooblin"
desc = "def"
shoot_name = "Anime Tears"
shoot_desc = "Fire sparkling tears alternating from left and right eyes. Cooldown: 0.2s, Magazine: 20"
ability1_name = "Boogie Bomb"
ability1_desc = "Throw a disco bomb that blinds all enemies in a large area on impact. 15s cooldown, 3s blind duration."
ability2_name = "Retreat"
ability2_desc = "Gain a temporary speed boost to escape to safety. 8s cooldown, 2.5s duration."
ult_name = "Summon Drooglin"
ult_desc = "Summon Drooglin the Dragon to close off everyone's farm entrance with harmful fire for 30s. The caster is unaffected."
